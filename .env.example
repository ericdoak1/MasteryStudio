OPENAI_API_KEY=sk-proj-...
PUBLIC_BASE_URL=https://your-service.example.com
PORT=3000

# Recommended in production. Used to reject forged Twilio webhooks.
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=+15039144682
OUTBOUND_API_KEY=

# Realtime settings
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin

# Optional Mastery member context endpoint.
# Called as GET ?phone=+15551234567 with Bearer authentication.
MASTERY_PROFILE_URL=
MASTERY_PROFILE_TOKEN=

# Linq blue iMessage
LINQ_API_TOKEN=
LINQ_WEBHOOK_SECRET=
OPENAI_TEXT_MODEL=gpt-5-mini
