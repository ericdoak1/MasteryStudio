OPENAI_API_KEY=sk-proj-...
PUBLIC_BASE_URL=https://your-service.example.com
PORT=3000

# Recommended in production. Used to reject forged Twilio webhooks.
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=+15039144682
OUTBOUND_API_KEY=

# Realtime settings
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin

# Emma live Mastery Studio context.
# Called on every direct conversation turn as:
# GET ?phone=+15551234567&scope=studio&include=all
# The endpoint must authenticate the phone to a member/org and return only data
# that member is allowed to see. This is Emma's source of truth across channels.
MASTERY_STUDIO_CONTEXT_URL=
MASTERY_STUDIO_CONTEXT_TOKEN=

# Legacy profile-only endpoint. Used only when the Studio context endpoint is absent.
MASTERY_PROFILE_URL=
MASTERY_PROFILE_TOKEN=

# Linq blue iMessage
LINQ_API_TOKEN=
LINQ_WEBHOOK_SECRET=
OPENAI_TEXT_MODEL=gpt-5-mini

# Emma voice notes. The key stays in Render or another secret manager.
ELEVENLABS_API_KEY=
ELEVENLABS_ENABLE_LOGGING=true
ELEVENLABS_VOICE_ID=S9EGwlCtMF7VXtENq79v
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2

# text: always text. voice: voice when short enough. auto: Emma chooses selectively.
LINQ_REPLY_MODE=auto
LINQ_VOICE_MAX_CHARACTERS=600
# A native voice memo must be its own message. Set true to send a separate text transcript.
LINQ_VOICE_SEND_TRANSCRIPT=false
